{
  "id": "artcraft",
  "name": "Crafting Apps",
  "version": "0.6.0",
  "apiVersion": 1,
  "publisher": "PiCode",
  "description": "Let your agents write documents, build presentations, work with spreadsheets, edit images and video, and lay out pages in ten Crafting Apps while you watch.",
  "icon": "icons/craft.svg",
  "permissions": [
    "screen:follow",
    "workspaces:read"
  ],
  "agent": {
    "mcpServers": {
      "photocraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "photocraft"
        ]
      },
      "vectorcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "vectorcraft"
        ]
      },
      "filmcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "filmcraft"
        ]
      },
      "effectcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "effectcraft"
        ]
      },
      "lightcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "lightcraft"
        ]
      },
      "designcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "designcraft"
        ]
      },
      "printcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "printcraft"
        ]
      },
      "wordcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "wordcraft"
        ]
      },
      "deckcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "deckcraft"
        ]
      },
      "gridcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "gridcraft"
        ]
      }
    },
    "skills": [
      "skills/photocraft",
      "skills/vectorcraft",
      "skills/effectcraft",
      "skills/filmcraft",
      "skills/lightcraft",
      "skills/designcraft",
      "skills/printcraft",
      "skills/wordcraft",
      "skills/deckcraft",
      "skills/gridcraft"
    ]
  },
  "process": {
    "command": "python3",
    "args": [
      "${extensionDir}/server/craft_page.py"
    ]
  },
  "ui": {
    "pages": [
      {
        "id": "apps",
        "title": "Crafting Apps",
        "path": "ui/apps.html"
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "open-apps",
        "title": "Open Crafting Apps",
        "page": "apps"
      }
    ],
    "openWith": [
      {
        "pattern": "*.pcraft",
        "page": "apps",
        "title": "Open in PhotoCraft"
      },
      {
        "pattern": "*.psd",
        "page": "apps",
        "title": "Open in PhotoCraft"
      },
      {
        "pattern": "*.vectorcraft",
        "page": "apps",
        "title": "Open in VectorCraft"
      },
      {
        "pattern": "*.svg",
        "page": "apps",
        "title": "Open in VectorCraft"
      },
      {
        "pattern": "*.ecproj",
        "page": "apps",
        "title": "Open in EffectCraft"
      },
      {
        "pattern": "*.fcproj",
        "page": "apps",
        "title": "Open in FilmCraft"
      },
      {
        "pattern": "*.designcraft",
        "page": "apps",
        "title": "Open in DesignCraft"
      },
      {
        "pattern": "*.pdf",
        "page": "apps",
        "title": "Open in PrintCraft"
      },
      {
        "pattern": "*.docx",
        "page": "apps",
        "title": "Open in WordCraft"
      },
      {
        "pattern": "*.odt",
        "page": "apps",
        "title": "Open in WordCraft"
      },
      {
        "pattern": "*.rtf",
        "page": "apps",
        "title": "Open in WordCraft"
      },
      {
        "pattern": "*.deckcraft",
        "page": "apps",
        "title": "Open in DeckCraft"
      },
      {
        "pattern": "*.pptx",
        "page": "apps",
        "title": "Open in DeckCraft"
      },
      {
        "pattern": "*.xlsx",
        "page": "apps",
        "title": "Open in GridCraft"
      },
      {
        "pattern": "*.csv",
        "page": "apps",
        "title": "Open in GridCraft"
      },
      {
        "pattern": "*.tsv",
        "page": "apps",
        "title": "Open in GridCraft"
      }
    ],
    "menus": {
      "workspace": [
        "open-apps"
      ]
    }
  },
  "activation": {
    "files": [
      "*.pcraft",
      "*.vectorcraft",
      "*.ecproj",
      "*.fcproj",
      "*.designcraft",
      "*.docx",
      "*.pptx",
      "*.xlsx"
    ]
  }
}
