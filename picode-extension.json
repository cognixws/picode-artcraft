{
  "id": "artcraft",
  "name": "Crafting Apps",
  "version": "0.2.1",
  "apiVersion": 1,
  "publisher": "PiCode",
  "description": "Let your agents work in PhotoCraft, VectorCraft, EffectCraft and FilmCraft while you watch: they edit images, draw vector art, animate and cut video in the real app windows and save into the workspace.",
  "icon": "icons/craft.svg",
  "agent": {
    "mcpServers": {
      "photocraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "photocraft"
        ]
      },
      "vectorcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "vectorcraft"
        ]
      },
      "filmcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "filmcraft"
        ]
      },
      "effectcraft": {
        "command": "python3",
        "args": [
          "${extensionDir}/server/craft_mcp.py",
          "effectcraft"
        ]
      }
    },
    "skills": [
      "skills/photocraft",
      "skills/vectorcraft",
      "skills/effectcraft",
      "skills/filmcraft"
    ]
  },
  "activation": {
    "files": [
      "*.pcraft",
      "*.vectorcraft",
      "*.ecproj",
      "*.fcproj"
    ]
  }
}
